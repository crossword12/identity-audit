# Adresse IP ou nom DNS du contrôleur de domaine
AD_HOST=192.168.1.100

# LDAP : 389
# LDAPS : 636
AD_PORT=389

# false pour LDAP, true pour LDAPS
AD_USE_SSL=false

# Exemple pour le domaine lab.local
AD_BASE_DN=DC=lab,DC=local

# Compte dédié à la lecture de l'annuaire
AD_BIND_USERNAME=collecteur@lab.local

# Ne jamais placer un vrai mot de passe dans ce fichier
AD_BIND_PASSWORD=change-me

AD_TIMEOUT_SECONDS=15